---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
}

const { title, subtitle, id } = Astro.props;
---

<div class="mx-auto max-w-3xl text-center">
  <h2
    id={id}
    class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
  >
    {title}
  </h2>
  {subtitle && (
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-gray-400">
      {subtitle}
    </p>
  )}
</div>
