---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={["overflow-hidden rounded-xl border border-gray-700/60 bg-gray-900 shadow-2xl shadow-black/40", className]}>
  <div class="flex items-center gap-2 border-b border-gray-700/40 bg-gray-800/80 px-4 py-3">
    <div class="flex gap-1.5">
      <span class="h-3 w-3 rounded-full bg-[#FF5F56]"></span>
      <span class="h-3 w-3 rounded-full bg-[#FFBD2E]"></span>
      <span class="h-3 w-3 rounded-full bg-[#27C93F]"></span>
    </div>
    {title && (
      <span class="ml-2 text-xs font-medium tracking-wide text-gray-500">
        {title}
      </span>
    )}
  </div>
  <div class="bg-gray-950">
    <slot />
  </div>
</div>
