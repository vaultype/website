---
import SectionHeading from '../shared/SectionHeading.astro';
---

<section id="features" class="py-24 px-6">
  <div data-animate>
    <SectionHeading
      title="Built for Privacy. Designed for Power."
      subtitle="Every feature runs locally on your Mac — no cloud, no compromises."
    />
  </div>

  <div
    data-animate-stagger
    class="mx-auto mt-16 grid max-w-6xl grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"
  >
    <!-- Zero-Network Architecture -->
    <div class="group rounded-2xl border border-gray-800 bg-gray-900/50 p-6 transition-all duration-300 hover:border-accent-500/50 hover:bg-gray-900">
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white">Zero-Network Architecture</h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-400">All processing happens on your Mac. No internet required. No data transmitted.</p>
    </div>

    <!-- Dual AI Pipeline -->
    <div class="group rounded-2xl border border-gray-800 bg-gray-900/50 p-6 transition-all duration-300 hover:border-accent-500/50 hover:bg-gray-900">
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white">Dual AI Pipeline</h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-400">whisper.cpp for speech recognition + llama.cpp for text enhancement, running locally.</p>
    </div>

    <!-- 6 Processing Modes -->
    <div class="group rounded-2xl border border-gray-800 bg-gray-900/50 p-6 transition-all duration-300 hover:border-accent-500/50 hover:bg-gray-900">
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L12 12.75 6.429 9.75m11.142 0l4.179 2.25L12 17.25 2.25 12l4.179-2.25m11.142 0l4.179 2.25-9.75 5.25-9.75-5.25 4.179-2.25" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white">6 Processing Modes</h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-400">Raw, Clean, Structure, Prompt, Code, and Custom modes for any workflow.</p>
    </div>

    <!-- Universal Text Injection -->
    <div class="group rounded-2xl border border-gray-800 bg-gray-900/50 p-6 transition-all duration-300 hover:border-accent-500/50 hover:bg-gray-900">
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zM12 2.25V4.5m5.834.166l-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243l-1.59-1.59" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white">Universal Text Injection</h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-400">Text appears at your cursor in any app — editors, terminals, browsers, everything.</p>
    </div>

    <!-- Voice Commands -->
    <div class="group rounded-2xl border border-gray-800 bg-gray-900/50 p-6 transition-all duration-300 hover:border-accent-500/50 hover:bg-gray-900">
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white">Voice Commands</h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-400">Launch apps, manage windows, and control your Mac with voice commands.</p>
    </div>

    <!-- App-Aware Context -->
    <div class="group rounded-2xl border border-gray-800 bg-gray-900/50 p-6 transition-all duration-300 hover:border-accent-500/50 hover:bg-gray-900">
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white">App-Aware Context</h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-400">Automatically selects the right processing mode based on your active application.</p>
    </div>

    <!-- 90+ Languages -->
    <div class="group rounded-2xl border border-gray-800 bg-gray-900/50 p-6 transition-all duration-300 hover:border-accent-500/50 hover:bg-gray-900">
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white">90+ Languages</h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-400">Automatic language detection with support for 90+ languages worldwide.</p>
    </div>

    <!-- Metal GPU Acceleration -->
    <div class="group rounded-2xl border border-gray-800 bg-gray-900/50 p-6 transition-all duration-300 hover:border-accent-500/50 hover:bg-gray-900">
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white">Metal GPU Acceleration</h3>
      <p class="mt-2 text-sm leading-relaxed text-gray-400">Leverages Apple Silicon's Metal GPU for fast, efficient on-device inference.</p>
    </div>
  </div>
</section>
