---
import SectionHeading from '../shared/SectionHeading.astro';

type CellValue = 'yes' | 'no' | 'partial' | 'limited' | string;

interface Row {
  feature: string;
  vaultype: CellValue;
  macwhisper: CellValue;
  superwhisper: CellValue;
  apple: CellValue;
}

const rows: Row[] = [
  { feature: 'Offline Processing', vaultype: 'yes', macwhisper: 'partial', superwhisper: 'partial', apple: 'partial' },
  { feature: 'Local LLM Processing', vaultype: 'yes', macwhisper: 'no', superwhisper: 'partial', apple: 'no' },
  { feature: 'Processing Modes', vaultype: '6', macwhisper: '1', superwhisper: '4+', apple: '1' },
  { feature: 'Text Injection', vaultype: 'All Apps', macwhisper: 'All Apps', superwhisper: 'All Apps', apple: 'All Apps' },
  { feature: 'Voice Commands', vaultype: 'yes', macwhisper: 'no', superwhisper: 'no', apple: 'limited' },
  { feature: 'App-Aware Context', vaultype: 'yes', macwhisper: 'no', superwhisper: 'yes', apple: 'no' },
  { feature: 'Open Source', vaultype: 'yes', macwhisper: 'no', superwhisper: 'no', apple: 'no' },
  { feature: 'Price', vaultype: 'Free', macwhisper: '$80', superwhisper: '$8/mo', apple: 'Free' },
];
---

<section id="comparison" class="py-24 px-6">
  <div data-animate>
    <SectionHeading
      title="How VaulType Compares"
      subtitle="The only fully offline, open-source solution with local LLM processing."
    />
  </div>

  <div data-animate class="mx-auto mt-16 max-w-5xl overflow-x-auto rounded-xl border border-gray-800">
    <table class="w-full min-w-[640px] text-left text-sm">
      <thead>
        <tr class="border-b border-gray-800 bg-gray-900/80">
          <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-gray-500">Feature</th>
          <th class="bg-accent-500/10 px-6 py-4 text-xs font-semibold uppercase tracking-wider text-accent-400">VaulType</th>
          <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-gray-500">MacWhisper</th>
          <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-gray-500">Superwhisper</th>
          <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-gray-500">Apple Dictation</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800/60">
        {rows.map(row => (
          <tr class="transition-colors hover:bg-gray-900/40">
            <td class="px-6 py-4 font-medium text-gray-300">{row.feature}</td>
            {[row.vaultype, row.macwhisper, row.superwhisper, row.apple].map((val, i) => (
              <td class:list={['px-6 py-4', i === 0 && 'bg-accent-500/5']}>
                {val === 'yes' ? (
                  <svg class="h-5 w-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                ) : val === 'no' ? (
                  <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                ) : val === 'partial' ? (
                  <span class="text-sm text-yellow-500">Partial</span>
                ) : val === 'limited' ? (
                  <span class="text-sm text-yellow-500">Limited</span>
                ) : (
                  <span class:list={['text-sm', i === 0 ? 'font-medium text-white' : 'text-gray-400']}>{val}</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
