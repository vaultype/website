---
import SectionHeading from '../shared/SectionHeading.astro';

// Deliberately states facts about VaulType only — no competitor claims,
// so nothing here goes stale when other products change pricing or features.
const reasons = [
  {
    title: 'Zero cloud, by architecture',
    body: 'There are no cloud features to opt into. Speech recognition and LLM processing run entirely on your Mac — the only network requests are optional model downloads.',
  },
  {
    title: 'Free and open source',
    body: 'GPL-3.0 licensed. No tiers, no subscriptions, no lifetime licenses. Read the code, audit it, or build it yourself.',
  },
  {
    title: 'Both AI engines built in',
    body: 'whisper.cpp and llama.cpp ship inside the app with Metal GPU acceleration. No separate installs, accounts, or local server setups.',
  },
  {
    title: 'Six processing modes',
    body: 'Raw, Clean, Structure, Prompt, Code, and Custom — with app-aware context that picks the right mode for the app you are dictating into.',
  },
  {
    title: 'Voice commands',
    body: 'Launch and switch apps, run Shortcuts, and define custom aliases by voice. The direct version adds window management, volume, and system controls.',
  },
  {
    title: 'Native menu bar app',
    body: 'Swift and SwiftUI, built for macOS 14+. Lightweight, hotkey-driven (including the fn/Globe key), and out of your way until you need it.',
  },
];
---

<section id="why-vaultype" class="py-24 px-6">
  <div data-animate>
    <SectionHeading
      title="Why VaulType?"
      subtitle="Privacy-first by architecture, not by policy."
    />
  </div>

  <div
    data-animate-stagger
    class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
  >
    {reasons.map(reason => (
      <div class="rounded-2xl border border-gray-800 bg-gray-900/50 p-7 transition-all duration-300 hover:border-gray-700">
        <div class="flex items-start gap-3">
          <svg class="mt-1 h-5 w-5 shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <div>
            <h3 class="text-base font-semibold text-white">{reason.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-400">{reason.body}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
