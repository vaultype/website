---

---

<section class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 pt-24 text-center">
  <!-- Background glow -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_40%,rgba(123,97,255,0.08),transparent_70%)]"></div>

  <div class="relative mx-auto max-w-4xl">
    <!-- App icon with animated waveform -->
    <div class="relative mx-auto mb-10 inline-block">
      <div class="absolute -inset-4 rounded-3xl bg-accent-500/20 blur-2xl"></div>
      <div class="relative h-24 w-24 overflow-hidden rounded-2xl shadow-2xl shadow-accent-500/30" role="img" aria-label="VaulType">
        <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
          <defs>
            <linearGradient id="hero-bg" x1="0" y1="0" x2="0" y2="512" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#2d1b4e"/>
              <stop offset="100%" stop-color="#130c24"/>
            </linearGradient>
            <linearGradient id="hero-bar" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#e2d6f5"/>
              <stop offset="100%" stop-color="#a78bfa"/>
            </linearGradient>
            <linearGradient id="hero-ring" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#5b4a8a"/>
              <stop offset="50%" stop-color="#7c6bb0"/>
              <stop offset="100%" stop-color="#5b4a8a"/>
            </linearGradient>
            <filter id="hero-glow">
              <feGaussianBlur stdDeviation="6" result="blur"/>
              <feComposite in="SourceGraphic" in2="blur" operator="over"/>
            </filter>
          </defs>
          <rect width="512" height="512" fill="url(#hero-bg)"/>
          <circle cx="256" cy="240" r="200" fill="#2a1a48" opacity="0.4"/>
          <circle cx="256" cy="256" r="175" fill="none" stroke="url(#hero-ring)" stroke-width="6" opacity="0.5"/>
          <g opacity="0.25" stroke="#7c6bb0" stroke-width="2.5" stroke-linecap="round">
            <line x1="256" y1="66" x2="256" y2="88"/><line x1="256" y1="424" x2="256" y2="446"/>
            <line x1="66" y1="256" x2="88" y2="256"/><line x1="424" y1="256" x2="446" y2="256"/>
            <line x1="122" y1="122" x2="138" y2="138"/><line x1="390" y1="122" x2="374" y2="138"/>
            <line x1="122" y1="390" x2="138" y2="374"/><line x1="390" y1="390" x2="374" y2="374"/>
          </g>
          <circle cx="256" cy="256" r="138" fill="#170e2e" stroke="#3a2a60" stroke-width="1.5" opacity="0.9"/>
          <circle cx="256" cy="256" r="198" fill="none" stroke="#2a1a50" stroke-width="1" opacity="0.5"/>
          <g filter="url(#hero-glow)">
            <rect x="176" y="228" width="10" height="56" rx="5" fill="url(#hero-bar)" opacity="0.7">
              <animate attributeName="height" values="56;40;56" dur="1.8s" repeatCount="indefinite"/>
              <animate attributeName="y" values="228;236;228" dur="1.8s" repeatCount="indefinite"/>
            </rect>
            <rect x="198" y="210" width="10" height="92" rx="5" fill="url(#hero-bar)" opacity="0.8">
              <animate attributeName="height" values="92;65;92" dur="1.5s" repeatCount="indefinite"/>
              <animate attributeName="y" values="210;223;210" dur="1.5s" repeatCount="indefinite"/>
            </rect>
            <rect x="220" y="192" width="10" height="128" rx="5" fill="url(#hero-bar)" opacity="0.9">
              <animate attributeName="height" values="128;90;128" dur="1.3s" repeatCount="indefinite"/>
              <animate attributeName="y" values="192;211;192" dur="1.3s" repeatCount="indefinite"/>
            </rect>
            <rect x="244" y="178" width="10" height="156" rx="5" fill="url(#hero-bar)" opacity="1">
              <animate attributeName="height" values="156;110;156" dur="1.1s" repeatCount="indefinite"/>
              <animate attributeName="y" values="178;201;178" dur="1.1s" repeatCount="indefinite"/>
            </rect>
            <rect x="268" y="192" width="10" height="128" rx="5" fill="url(#hero-bar)" opacity="0.9">
              <animate attributeName="height" values="128;85;128" dur="1.4s" repeatCount="indefinite"/>
              <animate attributeName="y" values="192;213;192" dur="1.4s" repeatCount="indefinite"/>
            </rect>
            <rect x="290" y="210" width="10" height="92" rx="5" fill="url(#hero-bar)" opacity="0.8">
              <animate attributeName="height" values="92;60;92" dur="1.6s" repeatCount="indefinite"/>
              <animate attributeName="y" values="210;226;210" dur="1.6s" repeatCount="indefinite"/>
            </rect>
            <rect x="312" y="228" width="10" height="56" rx="5" fill="url(#hero-bar)" opacity="0.7">
              <animate attributeName="height" values="56;35;56" dur="1.9s" repeatCount="indefinite"/>
              <animate attributeName="y" values="228;238;228" dur="1.9s" repeatCount="indefinite"/>
            </rect>
          </g>
        </svg>
      </div>
    </div>

    <!-- Headline -->
    <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl">
      Your voice stays private.
      <br />
      <span class="bg-gradient-to-r from-accent-300 via-accent-400 to-accent-500 bg-clip-text text-transparent">
        Text appears at your cursor.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-400 sm:text-xl">
      100% offline speech recognition powered by local AI. No cloud. No subscriptions.
      No data ever leaves your Mac.
    </p>

    <!-- CTA buttons -->
    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        id="download-dmg"
        href="https://github.com/vaultype/VaulType/releases"
        class="group inline-flex items-center gap-2.5 rounded-xl bg-accent-500 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-accent-500/25 transition-all hover:bg-accent-600 hover:shadow-xl hover:shadow-accent-500/30"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download
      </a>
      <a
        href="https://github.com/vaultype/vaultype"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-xl border border-gray-700 bg-gray-900/80 px-8 py-3.5 text-base font-semibold text-gray-200 transition-all hover:border-gray-600 hover:bg-gray-800"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
    </div>

    <!-- Brew command -->
    <div class="mt-10 inline-flex flex-col items-center gap-2 rounded-xl border border-gray-800 bg-gray-900/60 px-5 py-3 backdrop-blur-sm sm:flex-row sm:gap-3">
      <span class="text-xs font-medium uppercase tracking-wider text-gray-600">Install</span>
      <code class="font-mono text-sm text-gray-300">brew install --cask vaultype/vaultype/vaultype</code>
      <button
        id="copy-brew"
        class="rounded-md p-1 text-gray-500 transition-colors hover:text-accent-400"
        aria-label="Copy to clipboard"
      >
        <svg id="copy-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg id="check-icon" class="hidden h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce text-gray-600">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
    </svg>
  </div>
</section>

<script>
  document.getElementById('copy-brew')?.addEventListener('click', () => {
    navigator.clipboard.writeText('brew install --cask vaultype/vaultype/vaultype');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');
    copyIcon?.classList.add('hidden');
    checkIcon?.classList.remove('hidden');
    setTimeout(() => {
      copyIcon?.classList.remove('hidden');
      checkIcon?.classList.add('hidden');
    }, 2000);
  });
</script>
