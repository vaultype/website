---
import SectionHeading from '../shared/SectionHeading.astro';
---

<section id="download" class="py-24 px-6">
  <div data-animate>
    <SectionHeading
      title="Get VaulType"
      subtitle="Free, open source, and ready in seconds."
    />
  </div>

  <div
    data-animate-stagger
    class="mx-auto mt-16 grid max-w-6xl grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4"
  >
    <!-- Homebrew (Recommended) -->
    <div class="relative rounded-2xl border border-accent-500/50 bg-gray-900/80 p-8 shadow-lg shadow-accent-500/5 ring-1 ring-accent-500/20">
      <div class="mb-5 inline-block rounded-full bg-accent-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent-400">
        Recommended
      </div>
      <h3 class="text-xl font-bold text-white">Homebrew</h3>
      <p class="mt-2 text-sm text-gray-400">One command. Auto-updates included.</p>
      <div class="relative mt-6 overflow-hidden rounded-lg border border-gray-700/60 bg-gray-950 px-4 py-3 pr-12">
        <code class="break-all font-mono text-xs text-gray-300 sm:text-sm">brew install --cask vaultype/vaultype/vaultype</code>
        <button
          class="copy-btn absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-gray-500 transition-colors hover:text-accent-400"
          data-copy="brew install --cask vaultype/vaultype/vaultype"
          aria-label="Copy to clipboard"
        >
          <svg class="copy-icon h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <svg class="check-icon hidden h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- DMG -->
    <div class="rounded-2xl border border-gray-800 bg-gray-900/50 p-8 transition-all duration-300 hover:border-gray-700">
      <div class="mb-5 h-6"></div>
      <h3 class="text-xl font-bold text-white">Direct Download</h3>
      <p class="mt-2 text-sm text-gray-400">Download the latest .dmg from GitHub Releases.</p>
      <a
        id="download-dmg-section"
        href="https://github.com/vaultype/VaulType/releases"
        class="mt-6 inline-flex items-center gap-2 rounded-lg border border-gray-700 bg-gray-800 px-5 py-2.5 text-sm font-medium text-gray-200 transition-colors hover:border-gray-600 hover:bg-gray-700"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download .dmg
      </a>
    </div>

    <!-- Mac App Store -->
    <div class="rounded-2xl border border-gray-800 bg-gray-900/50 p-8 transition-all duration-300 hover:border-gray-700">
      <div class="mb-5 h-6"></div>
      <h3 class="text-xl font-bold text-white">Mac App Store</h3>
      <p class="mt-2 text-sm text-gray-400">
        Sandboxed version with App Store updates. Copies dictated text for ⌘V paste instead of typing at your cursor.<a href="#comparison-note" class="text-accent-400 hover:text-accent-300">*</a>
      </p>
      <a
        href="https://apps.apple.com/app/vaultype/id6759566772"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-lg border border-gray-700 bg-gray-800 px-5 py-2.5 text-sm font-medium text-gray-200 transition-colors hover:border-gray-600 hover:bg-gray-700"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 384 512" aria-hidden="true">
          <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.7-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
        </svg>
        View on App Store
      </a>
    </div>

    <!-- Build from Source -->
    <div class="rounded-2xl border border-gray-800 bg-gray-900/50 p-8 transition-all duration-300 hover:border-gray-700">
      <div class="mb-5 h-6"></div>
      <h3 class="text-xl font-bold text-white">Build from Source</h3>
      <p class="mt-2 text-sm text-gray-400">Clone the repo and build with Xcode.</p>
      <div class="relative mt-6 space-y-2 overflow-hidden rounded-lg border border-gray-700/60 bg-gray-950 px-4 py-3 pr-12">
        <div><code class="break-all font-mono text-xs text-gray-400 sm:text-sm">git clone https://github.com/vaultype/vaultype</code></div>
        <div><code class="font-mono text-xs text-gray-400 sm:text-sm">cd vaultype</code></div>
        <div><code class="font-mono text-xs text-gray-400 sm:text-sm">open VaulType.xcodeproj</code></div>
        <button
          class="copy-btn absolute right-2 top-2 rounded-md p-1.5 text-gray-500 transition-colors hover:text-accent-400"
          data-copy="git clone https://github.com/vaultype/vaultype && cd vaultype && open VaulType.xcodeproj"
          aria-label="Copy to clipboard"
        >
          <svg class="copy-icon h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <svg class="check-icon hidden h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <p id="comparison-note" data-animate class="mx-auto mt-8 max-w-3xl text-center text-sm leading-relaxed text-gray-500">
    * App Store sandbox rules don't allow apps to type into other apps, so the Mac App Store version
    delivers text via the clipboard (a prompt reminds you to press ⌘V) and limits voice commands to
    launching/switching apps, running Shortcuts, and custom aliases. The direct download and Homebrew
    versions type text at your cursor and include the full command set, global shortcut aliases,
    plugins, and battery-aware throttling. Speech recognition and LLM processing are identical —
    and 100% on-device — in both.
  </p>
</section>

<script>
  document.querySelectorAll('.copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      navigator.clipboard.writeText(btn.getAttribute('data-copy'));
      var copyIcon = btn.querySelector('.copy-icon');
      var checkIcon = btn.querySelector('.check-icon');
      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      setTimeout(function() {
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
      }, 2000);
    });
  });
</script>
